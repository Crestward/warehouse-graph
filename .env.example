# Copy to .env (git-ignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
# Hard cap on total LLM spend across all runs, USD (PRD §5.3)
LLM_BUDGET_USD=150

# Local Postgres (local profile only)
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=warehouse
POSTGRES_PORT=5432
# Login passwords of the policy roles (one per principal in policies.yml, plus audit_writer).
# Unset = local-dev-only-<role>. Set e.g. POSTGRES_PASSWORD_ANALYST_AU anywhere non-local.

# Databricks Free Edition (task 0.7 spike; databricks profile)
# Workspace URL from the browser address bar, e.g. https://dbc-1a2b3c4d-5e6f.cloud.databricks.com
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# SQL Warehouses -> your warehouse -> Connection details -> HTTP path, e.g. /sql/1.0/warehouses/abc123def456
DATABRICKS_HTTP_PATH=
